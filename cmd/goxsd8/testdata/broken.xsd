<?xml version="1.0" encoding="UTF-8"?>
<!-- Two independent schema errors, so the exit-1 path is exercised with more
     than one line and their order can be pinned. Both are src-resolve: a
     type= naming a type no schema document declares. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:b="http://example.com/broken"
           targetNamespace="http://example.com/broken">

  <xs:element name="first" type="b:NoSuchType"/>
  <xs:element name="second" type="b:AlsoMissing"/>

</xs:schema>
