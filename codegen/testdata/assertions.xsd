<?xml version="1.0"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:complexType name="range">
    <xs:sequence>
      <xs:element name="low" type="xs:int"/>
      <xs:element name="high" type="xs:int"/>
    </xs:sequence>
    <xs:attribute name="unit" type="xs:string"/>
    <xs:assert test="low le high"/>
  </xs:complexType>
  <xs:complexType name="labelledRange">
    <xs:complexContent>
      <xs:extension base="range">
        <xs:sequence>
          <xs:element name="label" type="xs:string"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="unitRange">
    <xs:complexContent>
      <xs:restriction base="range">
        <xs:sequence>
          <xs:element name="low" type="xs:int"/>
          <xs:element name="high" type="xs:int"/>
        </xs:sequence>
      </xs:restriction>
    </xs:complexContent>
  </xs:complexType>
  <xs:element name="span" type="range"/>
  <xs:element name="labelled" type="labelledRange"/>
  <xs:element name="unit" type="unitRange"/>
  <xs:element name="price">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:decimal">
          <xs:attribute name="currency" type="xs:string" use="required"/>
          <xs:assert test="$value ge 0"/>
        </xs:extension>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>
  <xs:element name="marker">
    <xs:complexType>
      <xs:assert test="empty(@*)"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="open">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="a" type="xs:string"/>
      </xs:sequence>
      <xs:anyAttribute/>
      <xs:assert test="true()"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
