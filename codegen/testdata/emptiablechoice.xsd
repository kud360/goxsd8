<?xml version="1.0"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:emptiablechoice"
           targetNamespace="urn:emptiablechoice">
  <xs:element name="optElement">
    <xs:complexType>
      <xs:choice>
        <xs:element name="a" type="xs:string"/>
        <xs:element name="b" type="xs:int" minOccurs="0"/>
      </xs:choice>
    </xs:complexType>
  </xs:element>
  <xs:element name="manyElement">
    <xs:complexType>
      <xs:choice>
        <xs:element name="a" type="xs:string"/>
        <xs:element name="b" type="xs:int" minOccurs="0" maxOccurs="unbounded"/>
      </xs:choice>
    </xs:complexType>
  </xs:element>
  <xs:element name="optWildcard">
    <xs:complexType>
      <xs:choice>
        <xs:element name="a" type="xs:string"/>
        <xs:any minOccurs="0"/>
      </xs:choice>
    </xs:complexType>
  </xs:element>
  <xs:element name="optGroups">
    <xs:complexType>
      <xs:choice>
        <xs:sequence minOccurs="0">
          <xs:element name="x" type="xs:string"/>
          <xs:element name="y" type="xs:string"/>
        </xs:sequence>
        <xs:choice minOccurs="0">
          <xs:element name="p" type="xs:string"/>
          <xs:element name="q" type="xs:string"/>
        </xs:choice>
        <xs:sequence minOccurs="0" maxOccurs="unbounded">
          <xs:element name="z" type="xs:string"/>
        </xs:sequence>
      </xs:choice>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="pick">
    <xs:choice>
      <xs:element name="a" type="xs:string"/>
      <xs:element name="b" type="xs:string" minOccurs="0"/>
    </xs:choice>
    <xs:attribute name="tag" type="xs:string"/>
  </xs:complexType>
  <xs:element name="holder">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="maybe" type="pick" minOccurs="0"/>
        <xs:element name="always" type="pick"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="repeated">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="a" type="xs:string"/>
        <xs:element name="b" type="xs:string" minOccurs="0"/>
      </xs:choice>
    </xs:complexType>
  </xs:element>
</xs:schema>
