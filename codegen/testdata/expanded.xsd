<?xml version="1.0"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:t" targetNamespace="urn:t">
  <!-- The two x siblings differ only in expanded name ({urn:t}x and x), so
       each gets its own nested struct, emitted once and shared by first and
       second (§3.3.2.3; cos-element-consistent binds only same-expanded-name
       siblings). -->
  <xs:complexType name="ct">
    <xs:sequence>
      <xs:element name="x" form="qualified">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="a" type="xs:string"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="x" form="unqualified">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="b" type="xs:boolean"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="first" type="t:ct"/>
  <xs:element name="second" type="t:ct"/>
</xs:schema>
