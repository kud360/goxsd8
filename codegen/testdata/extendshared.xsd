<?xml version="1.0"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <!-- The top-level element ct shares its expanded name with the complex
       type ct, in a separate symbol space (§3.3.2), and its anonymous type
       extends ct. The base particle's x has {scope}.{parent} ct
       (§3.3.2.3 dcl.elt.local), and the extension reuses that particle
       (§3.4.2.3.3 clause 4.2.3.3), so the element's x shares X with
       first's. -->
  <xs:complexType name="ct">
    <xs:sequence>
      <xs:element name="x">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="a" type="xs:string"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="first" type="ct"/>
  <xs:element name="ct">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="ct">
          <xs:sequence>
            <xs:element name="y">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="b" type="xs:boolean"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
</xs:schema>
