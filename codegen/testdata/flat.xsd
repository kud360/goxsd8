<?xml version="1.0"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:flat" targetNamespace="urn:flat"
           elementFormDefault="qualified">
  <xs:element name="note" type="xs:string"/>
  <xs:element name="record">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="title" type="xs:token"/>
        <xs:element name="link" type="xs:anyURI" minOccurs="0"/>
        <xs:element name="published" type="xs:boolean"/>
        <xs:element name="tag" type="code" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="alias" type="xs:NCName" minOccurs="2" maxOccurs="3"/>
        <xs:element name="flag" minOccurs="0">
          <xs:simpleType>
            <xs:restriction base="xs:boolean"/>
          </xs:simpleType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:simpleType name="code">
    <xs:restriction base="xs:string">
      <xs:maxLength value="8"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="entry" type="entryType"/>
  <xs:complexType name="entryType">
    <xs:complexContent>
      <xs:restriction base="xs:anyType">
        <xs:sequence>
          <xs:element name="key" type="code"/>
        </xs:sequence>
      </xs:restriction>
    </xs:complexContent>
  </xs:complexType>
</xs:schema>
