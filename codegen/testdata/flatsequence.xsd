<?xml version="1.0"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:flatsequence"
           targetNamespace="urn:flatsequence">
  <xs:group name="h">
    <xs:choice>
      <xs:element name="p" type="xs:string"/>
      <xs:element name="q" type="xs:string"/>
    </xs:choice>
  </xs:group>
  <xs:element name="many">
    <xs:complexType>
      <xs:sequence maxOccurs="unbounded">
        <xs:element name="x" type="xs:string" minOccurs="0"/>
        <xs:element name="x" form="qualified" type="xs:boolean" minOccurs="0"/>
        <xs:group ref="t:h" minOccurs="0"/>
        <xs:sequence minOccurs="0">
          <xs:element name="r" type="xs:string"/>
          <xs:element name="n" type="xs:int" nillable="true"/>
        </xs:sequence>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="nested">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="head" type="xs:string"/>
        <xs:sequence minOccurs="2" maxOccurs="2">
          <xs:sequence/>
        </xs:sequence>
        <xs:element name="tail" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
