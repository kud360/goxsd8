<?xml version="1.0"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:t" targetNamespace="urn:t">
  <!-- A <complexContent> restriction of a complex type other than
       xs:anyType gets a type of its own, built from its own {content type}
       (§3.4.2.3.3 dcl.ctd.ctcc.common) and {attribute uses} (§3.4.2.4
       dcl.ctd.attuses), with no Go-level relation to its base's. narrow
       narrows a from 0..1 to 1..1 and b from 1..unbounded to 1..1, and
       prohibits note, so its type has no Note field; id it inherits. same
       restricts item to identical content and still gets a type of its
       own. -->
  <xs:complexType name="item">
    <xs:sequence>
      <xs:element name="a" type="xs:string" minOccurs="0"/>
      <xs:element name="b" type="xs:int" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="note" type="xs:string"/>
  </xs:complexType>
  <xs:complexType name="narrow">
    <xs:complexContent>
      <xs:restriction base="t:item">
        <xs:sequence>
          <xs:element name="a" type="xs:string"/>
          <xs:element name="b" type="xs:int"/>
        </xs:sequence>
        <xs:attribute name="note" type="xs:string" use="prohibited"/>
      </xs:restriction>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="same">
    <xs:complexContent>
      <xs:restriction base="t:item">
        <xs:sequence>
          <xs:element name="a" type="xs:string" minOccurs="0"/>
          <xs:element name="b" type="xs:int" maxOccurs="unbounded"/>
        </xs:sequence>
      </xs:restriction>
    </xs:complexContent>
  </xs:complexType>
  <xs:element name="holder">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="wide" type="t:item"/>
        <xs:element name="narrowed" type="t:narrow"/>
        <xs:element name="copy" type="t:same"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="base" type="t:item"/>
  <xs:element name="derived" type="t:narrow"/>
</xs:schema>
