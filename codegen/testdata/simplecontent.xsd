<?xml version="1.0"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:t" targetNamespace="urn:t">
  <!-- A complex type with simple content (§3.4.2.2 dcl.ctd.ctsc) gets a
       struct whose first field, Value, holds what its {simple type
       definition} maps to, followed by its attribute fields (§3.4.2.4
       dcl.ctd.attuses). labelled extends xs:string with a required and an
       optional attribute; short restricts labelled, narrowing a facet, and
       inherits both attributes; tagged extends labelled (case 3) and adds
       one; counted extends the user atomic type qty, and capped restricts
       counted, its anonymous {simple type definition} reaching xs:int
       through counted's; listed extends the list type ints; wrapped
       restricts xs:anyType with an inline <simpleType>; valued has an
       attribute named value, which takes Value2. The element date's type is
       claimed before the datatype struct its Value field needs, so the
       struct is Date2. -->
  <xs:simpleType name="qty">
    <xs:restriction base="xs:int">
      <xs:maxInclusive value="100"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ints">
    <xs:list itemType="xs:int"/>
  </xs:simpleType>
  <xs:complexType name="labelled">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="lang" type="xs:language" use="required"/>
        <xs:attribute name="note" type="xs:string"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="short">
    <xs:simpleContent>
      <xs:restriction base="t:labelled">
        <xs:maxLength value="10"/>
      </xs:restriction>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="tagged">
    <xs:simpleContent>
      <xs:extension base="t:labelled">
        <xs:attribute name="tag" type="xs:int"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="counted">
    <xs:simpleContent>
      <xs:extension base="t:qty">
        <xs:attribute name="unit" type="xs:string" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="capped">
    <xs:simpleContent>
      <xs:restriction base="t:counted">
        <xs:maxInclusive value="10"/>
      </xs:restriction>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="listed">
    <xs:simpleContent>
      <xs:extension base="t:ints"/>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="wrapped">
    <xs:simpleContent>
      <xs:restriction base="xs:anyType">
        <xs:simpleType>
          <xs:restriction base="xs:boolean"/>
        </xs:simpleType>
      </xs:restriction>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="valued">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="value" type="xs:string"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:element name="label" type="t:labelled"/>
  <xs:element name="brief" type="t:short"/>
  <xs:element name="tagged" type="t:tagged"/>
  <xs:element name="count" type="t:counted"/>
  <xs:element name="cap" type="t:capped"/>
  <xs:element name="list" type="t:listed"/>
  <xs:element name="flag" type="t:wrapped"/>
  <xs:element name="valued" type="t:valued"/>
  <xs:element name="holder">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="first" type="t:labelled"/>
        <xs:element name="rest" type="t:labelled" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="inline">
          <xs:complexType>
            <xs:simpleContent>
              <xs:extension base="xs:double">
                <xs:attribute name="scale" type="xs:int"/>
              </xs:extension>
            </xs:simpleContent>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="date">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:date"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>
</xs:schema>
